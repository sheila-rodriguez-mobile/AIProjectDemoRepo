{
  "pull_request_thresholds": {
    "warning_days": 7,
    "escalated_days": 14,
    "final_notice_days": 21
  },
  "exempt_pr_labels": [
    "no-stale",
    "security",
    "blocked"
  ],
  "managed_labels": [
    "stale:warning",
    "stale:escalated",
    "stale:final-notice"
  ],
  "branch_thresholds": {
    "stale_days": 30,
    "delete_candidate_days": 60
  },
  "exempt_branch_patterns": [
    "main",
    "master",
    "develop",
    "release/*",
    "hotfix/*"
  ],
  "protected_label": "Do_Not_Delete",
  "additional_mentions": []
}
